<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title or (site.name + " | Portfolio") %}
  {%- set pageDescription = description or site.description %}
  {%- set pageUrl = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta name="author" content="{{ site.name }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="/favicon.ico">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ site.url }}/img/MugshotCard.jpg">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/img/MugshotCard.jpg">
  <meta name="twitter:site" content="{{ site.twitter }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">

  <!-- Set the saved theme before paint to avoid a flash -->
  <script>
    try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;600&family=Atkinson+Hyperlegible+Next:wght@300;400;600&family=Patrick+Hand&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-8T9TBP554C"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8T9TBP554C');
  </script>
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/">{{ site.name }}</a>
    <nav>
      {%- set links = [["Home", "/"], ["Blog", "/blogs/"], ["Projects", "/projects/"], ["Experience", "/experience/"]] %}
      {%- for link in links %}
      <a href="{{ link[1] }}"{% if page.url == link[1] or (link[1] == "/blogs/" and page.url and page.url.startsWith("/blogs/")) %} aria-current="page"{% endif %}>{{ link[0] }}</a>
      {%- endfor %}
    </nav>
    <button
      class="theme-toggle"
      x-data="{ dark: document.documentElement.dataset.theme === 'dark' }"
      @click="dark = !dark; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; try { localStorage.setItem('theme', document.documentElement.dataset.theme) } catch (e) {}"
      x-text="dark ? 'Light' : 'Dark'"
      aria-label="Switch light or dark mode"
    >Dark</button>
  </header>

  <main class="page">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <span>© {{ site.name }}</span>
    <div>
      <a href="{{ site.github }}">GitHub</a>
      <a href="{{ site.linkedin }}">LinkedIn</a>
      <a href="https://x.com/{{ site.twitter | replace("@", "") }}">Twitter</a>
      <a href="mailto:{{ site.email }}">Email</a>
    </div>
  </footer>
</body>
</html>
